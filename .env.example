# 扶摇金融数据 API Key（fuyao.aicubes.cn → API Key 管理）
FUYAO_API_KEY=
# DeepSeek API Key（platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# iFinD MCP：个人中心 → MCP → 生成配置，取综合服务 hexin-ifind-ds-mcp 的 url 和 Authorization
IFIND_MCP_URL=
IFIND_MCP_AUTH=
# iFinD 免费试用总额 2000 次，超过这个数后只用扶摇
IFIND_QUOTA_LIMIT=1800
# SQLite 数据目录，默认 ./data
DATA_DIR=
